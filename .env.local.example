# --- Supabase (shared 6x7 project; client scoped to the `translator` schema) ---
NEXT_PUBLIC_SUPABASE_URL=https://fmrnqepyyjucnfbrqawl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sb_publishable_anon_key>
# Server-only, bypasses RLS. Required for file/image upload + usage metering.
SUPABASE_SERVICE_ROLE_KEY=<sb_service_role_key>

# Monthly usage caps (enforced server-side)
QUOTA_SECONDS_MONTH=10800
QUOTA_CHARS_MONTH=500000

# --- Speech-to-text (live fallback for iOS/Safari + all file translation) ---
GROQ_API_KEY=<your_groq_key>
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Translation brain (at least one recommended; else free MT is used) ---
OPENROUTER_API_KEY=<your_openrouter_key>
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Engine priority when TRANSLATION_ENGINE=auto: DeepL -> Google -> LLM -> LibreTranslate -> MyMemory
# For production quality, set DEEPL_API_KEY in Vercel (Project → Settings → Environment Variables).
# Free tier: https://www.deepl.com/pro-api — use key ending in :fx for api-free.deepl.com
TRANSLATION_ENGINE=auto
DEEPL_API_KEY=
GOOGLE_CLOUD_TRANSLATE_KEY=

# --- Free machine-translation fallback (optional, zero-cost) ---
# If unset, MyMemory's public API is used (requires detected source — not raw auto).
# Set to a LibreTranslate instance to prefer it.
LIBRETRANSLATE_URL=

# --- Page Assistant (grounded in-app assistant; packages/page-assistant) ---
# Uses the same LLM keys as above. Router order: Anthropic → OpenAI → OpenRouter.
ANTHROPIC_API_KEY=
PA_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
PA_OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# Optional premium voice (else browser Web Speech API)
ELEVENLABS_API_KEY=
PA_ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM
# Public app URL for llm.txt / agent discovery (set in production)
NEXT_PUBLIC_APP_URL=
